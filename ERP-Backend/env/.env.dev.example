# DEV (your own computer): settings for the API.
# Copy this file to env/.env.dev and fill it in. The real file is never committed.
# Run it with:  npm run dev:dev   or   npm run start:dev

PORT=5000
NODE_ENV=development

# Supabase project for this environment (use a separate project for UAT, PREPROD and PROD)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
DATABASE_URL=
DATABASE_POOLER_URL=

# Addresses of the websites that may call this API, separated by commas
CORS_ORIGIN=http://localhost:3000
# Public addresses, used in emails and links
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# Who may create the first Super Administrator profile (comma separated emails)
SUPER_ADMIN_EMAILS=

# Payments (Razorpay): use test keys here
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# SMS (MSG91) and WhatsApp (Meta Cloud API)
MSG91_AUTH_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Set to true to stop reminders and scheduled announcements from going out from this environment
DISABLE_SCHEDULER=true
