PORT=5000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=
DATABASE_POOLER_URL=
# Comma-separated emails treated as SuperAdmin until a user_profiles row exists
SUPER_ADMIN_EMAILS=

# Online payments (Razorpay). Leave blank to disable; schools then pay by bank transfer.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to true only when the backend sits behind a proxy you control (needed for IP restrictions)
TRUST_PROXY=

# Email: any SMTP provider (Amazon SES, Brevo, Zoho, Google Workspace, Microsoft 365...)
SMTP_HOST=
SMTP_PORT=587
# true for port 465; false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address when none is set under Settings -> Email & SMS
MAIL_FROM=
# SMS: MSG91 Flow API (each SMS template must be DLT approved; add its id under Communication -> Templates)
MSG91_AUTH_KEY=
# WhatsApp: Meta WhatsApp Business Cloud API (messages use templates approved by Meta; add the template name under Communication -> WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Public address of this API (https://api.example.com), used for the image that records email opens
API_PUBLIC_URL=
# Public address of the web app, used for links in emails
APP_URL=http://localhost:3000
# Set to true to stop the daily reminder job on this server
DISABLE_SCHEDULER=
